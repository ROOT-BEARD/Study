<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/breakLabel"
        android:layout_width="62dp"
        android:layout_height="21dp"
        android:layout_marginStart="104dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="Break"
        app:layout_constraintBottom_toTopOf="@+id/breakInput"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/timerView"
        android:layout_width="242dp"
        android:layout_height="95dp"
        android:layout_marginStart="111dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="112dp"
        android:gravity="center"
        android:text="00:00"
        android:textSize="60sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timerLabel" />

    <TextView
        android:id="@+id/timerLabel"
        android:layout_width="300dp"
        android:layout_height="48dp"
        android:layout_marginStart="111dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="112dp"
        android:gravity="center"
        android:text="Session"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.523"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/resetButton"
        app:backgroundTint="@color/worm"
        android:layout_width="329dp"
        android:layout_height="82dp"
        android:layout_marginStart="125dp"
        android:layout_marginEnd="125dp"
        android:layout_marginBottom="52dp"
        android:text="Reset"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/startStopButton"
        app:backgroundTint="@color/worm"
        android:layout_width="329dp"
        android:layout_height="82dp"
        android:layout_marginStart="125dp"
        android:layout_marginEnd="125dp"
        android:layout_marginBottom="20dp"
        android:text="Start/Stop"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        app:layout_constraintBottom_toTopOf="@+id/resetButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/breakInput"
        android:layout_width="102dp"
        android:layout_height="48dp"
        android:layout_marginStart="84dp"
        android:layout_marginTop="59dp"
        android:background="@drawable/text_box"
        android:gravity="center"
        android:inputType="text"
        android:padding="8dp"
        android:text="@string/_short_break_default"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timerView" />

    <EditText
        android:id="@+id/longBreakInput"
        android:layout_width="102dp"
        android:layout_height="48dp"
        android:layout_marginStart="84dp"
        android:layout_marginTop="152dp"
        android:background="@drawable/text_box"
        android:gravity="center"
        android:inputType="text"
        android:padding="8dp"
        android:text="@string/_long_break_default"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timerView" />

    <EditText
        android:id="@+id/sessionInput"
        android:layout_width="102dp"
        android:layout_height="48dp"
        android:layout_marginTop="59dp"
        android:layout_marginEnd="85dp"
        android:background="@drawable/text_box"
        android:gravity="center"
        android:inputType="text"
        android:padding="8dp"
        android:text="@string/_session_default"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timerView" />

    <TextView
        android:id="@+id/longBreakLabel"
        android:layout_width="80dp"
        android:layout_height="21dp"
        android:layout_marginStart="95dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="Long Break"
        app:layout_constraintBottom_toTopOf="@+id/longBreakInput"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/sessionLabel"
        android:layout_width="62dp"
        android:layout_height="21dp"
        android:layout_marginEnd="104dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="Session"
        app:layout_constraintBottom_toTopOf="@+id/sessionInput"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>